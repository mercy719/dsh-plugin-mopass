{
  "name": "dsh-plugin-mopass",
  "version": "0.1.0",
  "description": "Leqee Mopass gateway provider for DeepSeek Harness — install, paste your Mopass API key, fetch your models. 在 DeepSeek Harness 中接入乐其 Mopass 网关：安装后填入你的 Mopass API Key，拉取属于你的模型即可使用。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "mopass",
    "leqee",
    "gateway",
    "llm",
    "provider"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-org/dsh-plugin-mopass.git"
  }
}
